# --- Database ---
# ローカル開発は `docker compose up -d` で起動するPostgresを利用できます
DATABASE_URL="postgresql://sns:sns@localhost:5432/sns_note_automation"

# --- App secrets ---
# セッションJWT署名用。32文字以上のランダム文字列を設定してください (例: `openssl rand -base64 32`)
APP_SECRET="change-me-to-a-random-32byte-string"
# 各プラットフォームの認証情報(APIキー等)をDBに保存する際の暗号化キー。32バイト(base64)。
# 生成例: `openssl rand -base64 32`
APP_ENCRYPTION_KEY="change-me-to-a-random-32byte-base64-key"

# --- 初期管理者アカウント (初回 `npm run db:seed` で作成) ---
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-please"

# --- AI (Anthropic Claude) ---
# コンテンツ下書き自動生成に使用します
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Cron / スケジュール投稿 ---
# /api/cron/publish を叩く際に Authorization: Bearer <CRON_SECRET> を要求します
CRON_SECRET="change-me-to-a-random-string"

# --- デプロイ先URL (GitHub Actionsからcronを叩く際に使用) ---
APP_BASE_URL="http://localhost:3000"
